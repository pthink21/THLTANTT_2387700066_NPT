{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "buoi5-sast",
          "rules": [
            {
              "id": "PY-SQL-FSTRING",
              "shortDescription": {
                "text": "Truy vấn SQL nội suy chuỗi có thể gây SQL injection."
              }
            },
            {
              "id": "PY-EVAL",
              "shortDescription": {
                "text": "eval() có thể thực thi biểu thức không tin cậy."
              }
            },
            {
              "id": "PY-SHELL",
              "shortDescription": {
                "text": "Lệnh hệ thống với shell=True có nguy cơ command injection."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PY-SQL-FSTRING",
          "level": "warning",
          "message": {
            "text": "Truy vấn SQL nội suy chuỗi có thể gây SQL injection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/vulnerable_01.py"
                },
                "region": {
                  "startLine": 6
                }
              }
            }
          ]
        },
        {
          "ruleId": "PY-EVAL",
          "level": "error",
          "message": {
            "text": "eval() có thể thực thi biểu thức không tin cậy."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/vulnerable_01.py"
                },
                "region": {
                  "startLine": 7
                }
              }
            }
          ]
        },
        {
          "ruleId": "PY-SHELL",
          "level": "error",
          "message": {
            "text": "Lệnh hệ thống với shell=True có nguy cơ command injection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/vulnerable_01.py"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
